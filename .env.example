# ============================================================
# Application
# ============================================================

APP_NAME=MyImpact AI
APP_VERSION=0.1.0
APP_ENV=development
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AUTH_ISSUER=http://127.0.0.1:8001
AUTH_AUDIENCE=myimpact-platform
AUTH_JWKS_URL=http://127.0.0.1:8001/.well-known/jwks.json
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ============================================================
# Application-DB
# ============================================================
DATABASE_URL=

# ============================================================
# LLM Provider
# ============================================================

LLM_PROVIDER=groq

# Supported values:
# groq
# azure


# ============================================================
# Groq
# ============================================================

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b


# ============================================================
# Azure OpenAI
# ============================================================

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# ============================================================
# GitHub / Jira evidence discovery
# ============================================================
# Generate this once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOURCE_TOKEN_ENCRYPTION_KEY=
# Use a separate random secret for signed OAuth state.
SOURCE_OAUTH_STATE_SECRET=
SOURCE_INTEGRATIONS_WEB_URL=http://localhost:5174
# Optional single-user local development tokens. These are disabled by default
# and are rejected unless APP_ENV=development.
SOURCE_LOCAL_TOKENS_ENABLED=false
# On macOS, set true to read the credentials below from Keychain instead.
SOURCE_LOCAL_TOKENS_FROM_KEYCHAIN=false
SOURCE_DEMO_MOCKS_ENABLED=false
GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Keychain service: MyImpact-local
# Keychain accounts: GITHUB_TOKEN and JIRA_API_TOKEN

# GitHub App user authorization callback:
# http://127.0.0.1:8000/api/v1/integrations/oauth/callback/github
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/oauth/callback/github

# Atlassian OAuth 2.0 (3LO) callback:
# http://127.0.0.1:8000/api/v1/integrations/oauth/callback/jira
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/oauth/callback/jira